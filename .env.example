# === Empleo CRM · variables de entorno ===
# Copia este archivo a `.env` y rellena tus valores. NUNCA subas `.env` a git.

# Cadena de conexión a la BD Postgres `empleo`.
# El search_path=empleo va en la propia URL (?options=-c%20search_path%3Dempleo).
# Formato: postgres://USUARIO:PASSWORD@HOST:PUERTO/empleo?options=-c%20search_path%3Dempleo
DATABASE_URL=postgres://empleo_web:CHANGE_ME@127.0.0.1:5432/empleo?options=-c%20search_path%3Dempleo

# (Opcional) Base del webhook de n8n para acciones IA (aplicar, generar CV, radar…).
# Si no usas n8n, deja esto vacío y los botones que llaman a n8n quedarán inactivos.
N8N_WEBHOOK_BASE=

# (Opcional) Puerto del servidor (por defecto 3010).
PORT=3010

# (Opcional) Login de la web. Si defines APP_PASSWORD, la web pide contraseña para entrar.
# Déjalo vacío para acceso abierto (recomendado solo en LAN/VPN). Pon un AUTH_SECRET largo y aleatorio.
APP_PASSWORD=
AUTH_SECRET=

# ============================================================
#  Solo para `docker compose up` (despliegue 3 piezas)
#  Las de arriba (DATABASE_URL, N8N_WEBHOOK_BASE, PORT) son para desarrollo local;
#  en Docker las define el propio compose. Aquí solo necesitas:
# ============================================================
DB_PASSWORD=cambia_esta_password        # contraseña de Postgres en el contenedor
WEB_PORT=3010                           # puerto público de la web
SCORE_INTERVAL_MIN=15                   # cada cuánto puntúa el worker
INGEST_RSS=1                            # 1 = el worker ingesta RSS (sin scraper Python)
INGEST_INTERVAL_MIN=360
