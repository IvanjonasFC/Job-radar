# === Scraper de ofertas · variables de entorno ===
# Copia a `.env` y rellena. El scraper inserta ofertas en empleo.job_offers (status='nueva').

# --- Config desde la web (recomendado) ---
# Si =1 (por defecto), el scraper lee portales/términos/países/zona/RSS de empleo.settings
# (lo que definas en la pestaña Config de la web manda). Pon =0 para usar solo este .env.
SETTINGS_FROM_DB=1

# --- Base de datos (obligatorio) ---
PG_HOST=          # host/IP del Postgres (nombre del contenedor si comparten red)
PG_PORT=5432
PG_DB=empleo
PG_USER=empleo_worker
PG_PASS=          # contraseña del usuario de escritura

# --- Cobertura de búsqueda (ajusta a tu caso) ---
COUNTRIES=spain
SITES=indeed,linkedin
WORKERS=4
RESULTS_WANTED=40
HOURS_OLD=168     # antigüedad máxima de la oferta (horas). 72 = ~3 días

# Términos de búsqueda (CSV). Por defecto: perfiles IT.
SEARCH_TERMS=desarrollador,programador,full stack developer,backend developer,frontend developer,devops,administrador de sistemas,data engineer

# --- Enfoque local (opcional) ---
# Trae remoto nacional + cualquier modalidad en tu zona.
HOME_COUNTRY=spain
HOME_LOCATION=Asturias, Spain
LOCAL_CITIES=asturias,gijon,oviedo,aviles
FILTER=it_local_remote

# Feeds RSS extra (CSV). Portales que dan RSS.
RSS_FEEDS=https://weworkremotely.com/categories/remote-programming-jobs.rss

# Proxies (opcional, CSV "user:pass@host:port"). Vacío = salida directa.
PROXIES=
