# === Worker autónomo · variables de entorno ===
# Alternativa a n8n: puntúa, genera carta/CV y prep de entrevista, y (opcional) ingesta RSS.
# Copia a `.env`. Las claves de IA puedes ponerlas AQUÍ o en la pestaña Config de la web (recomendado).

# --- Base de datos (obligatorio) ---
DATABASE_URL=postgres://empleo_worker:CHANGE_ME@127.0.0.1:5432/empleo
# (o por partes)
# PG_HOST=127.0.0.1
# PG_PORT=5432
# PG_DB=empleo
# PG_USER=empleo_worker
# PG_PASS=

# --- Servidor / bucles ---
PORT=8080
SCORE_INTERVAL_MIN=15     # cada cuánto puntúa ofertas nuevas
INGEST_RSS=0             # 1 = el worker ingesta RSS (no necesitas el scraper Python para lo básico)
INGEST_INTERVAL_MIN=360  # cada cuánto lee los feeds RSS (si INGEST_RSS=1)

# --- Paridad n8n (todo menos Telegram). ON por defecto; pon 0 para apagar cada uno ---
DIGEST_ON=1              # WF2: genera _TABLERO.md + candidaturas.csv
DIGEST_INTERVAL_MIN=720  # ~ 9:00 y 20:00
HEALTH_ON=1             # WF4: healthcheck + caduca ofertas >30 días
HEALTH_INTERVAL_MIN=1440 # diario
REMIND_ON=1             # WF5: recordatorios de seguimiento
REMIND_INTERVAL_MIN=1440 # diario

# --- Export a ficheros (equivale al /vault/Ofertas que montaba n8n) ---
EXPORT_FILES=1                    # 0 = no escribir ficheros (solo BD)
EXPORT_DIR=/vault/Ofertas        # móntalo como volumen en Docker
# EXPORT_FOOTER=Tu Nombre | tu-email | tu-web | tu-github

# --- Claves de IA (opcional aquí; mejor en Config de la web). Con UNA basta; el resto es fallback ---
GROQ_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
# OLLAMA_URL=http://localhost:11434/v1   # IA local, sin clave
