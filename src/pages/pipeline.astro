---
import Base from '../layouts/Base.astro';
import KanbanBoard from '../components/KanbanBoard';
import { sql } from '../lib/db';
import { ubi } from '../lib/loc';
import { getConfig, esLocal } from '../lib/config';

const MAX_ABIERTAS = 80; // no volcar 400 tarjetas al DOM; el resto está en /ofertas

let rows: any[] = [];
let recs: any[] = [];
let err: string | null = null;
const cfg = await getConfig();
try {
  rows = await sql<any[]>`
    SELECT o.id, o.title, o.company, o.location, o.modalidad, o.score, o.status,
           a.stage,
           to_char(o.applied_at,'YYYY-MM-DD') AS f_apl,
           to_char(o.generated_at,'YYYY-MM-DD') AS f_gen,
           to_char(o.first_seen,'YYYY-MM-DD') AS f_seen
    FROM empleo.job_offers o
    LEFT JOIN LATERAL (
      SELECT stage FROM empleo.applications a2 WHERE a2.offer_id = o.id ORDER BY updated_at DESC NULLS LAST LIMIT 1
    ) a ON true
    WHERE o.status IN ('evaluada','notificada','generada','aplicada')
      AND o.first_seen >= now() - interval '60 days'
    ORDER BY o.score DESC NULLS LAST`;
  // Recordatorios: entrevistas, próximas acciones y seguimiento (fusionado desde /recordatorios)
  recs = await sql<any[]>`
    SELECT offer_id, company, title, fecha_entrevista, fecha_proxima, proxima_accion,
           to_char(applied_at,'YYYY-MM-DD') AS postulada,
           (fecha_entrevista IS NOT NULL AND fecha_entrevista::date < current_date) AS venc_ent,
           (fecha_proxima IS NOT NULL AND fecha_proxima::date < current_date) AS venc_prox
    FROM empleo.applications
    WHERE fecha_entrevista IS NOT NULL OR fecha_proxima IS NOT NULL OR stage = 'postulada'
    ORDER BY fecha_entrevista ASC NULLS LAST, fecha_proxima ASC NULLS LAST`;
} catch (e: any) { err = e?.message ?? String(e); }

const colOf = (o: any): string => {
  if (o.status === 'evaluada' || o.status === 'notificada') return 'abiertas';
  if (o.status === 'generada') return 'cv';
  if (o.status === 'aplicada') {
    const s = o.stage || 'postulada';
    if (['oferta', 'aceptada', 'rechazada'].includes(s)) return 'resuelta';
    if (['prueba_tecnica', 'entrevista_tecnica', 'entrevista_rrhh'].includes(s)) return 'entrevista';
    return 'postulada';
  }
  return 'abiertas';
};
const initial: Record<string, any[]> = { abiertas: [], cv: [], postulada: [], entrevista: [], resuelta: [] };
for (const o of rows) {
  const k = colOf(o);
  const fecha = o.status === 'aplicada' ? o.f_apl : o.status === 'generada' ? o.f_gen : o.f_seen;
  initial[k].push({ id: o.id, company: o.company, title: o.title, ubi: ubi(o), cerca: esLocal(o.location, o.modalidad, cfg), score: o.score, fecha });
}
// "Abiertas" puede tener cientos: mostramos las de mejor encaje y avisamos del resto.
const abiertasTotal = initial.abiertas.length;
const abiertasOcultas = Math.max(0, abiertasTotal - MAX_ABIERTAS);
initial.abiertas = initial.abiertas.slice(0, MAX_ABIERTAS);
---
<Base title="Pipeline">
  <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:16px;">
    <div>
      <h1 style="margin:0;">Pipeline</h1>
      <p style="color:var(--color-muted); margin:4px 0 0;">Arrastra una oferta a <strong>Postuladas</strong> para aplicar (con fecha), y avánzala por Entrevista → Resuelta según progresa.</p>
    </div>
  </div>
  {err && <div class="card" style="padding:16px; border-color:var(--color-danger); color:var(--color-danger);">{err}</div>}

  {!err && recs.length > 0 && (
    <section class="card" style="padding:0; margin-bottom:22px;">
      <div style="padding:14px 18px; border-bottom:1px solid var(--color-border); display:flex; align-items:center; gap:10px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        <h3 style="margin:0; font-size:1rem;">Recordatorios · entrevistas y próximas acciones <span style="color:var(--color-muted); font-weight:400;">({recs.length})</span></h3>
      </div>
      <div style="overflow:auto;">
        <table style="width:100%; border-collapse:collapse; font-size:.88rem;">
          <thead><tr style="text-align:left; color:var(--color-muted); white-space:nowrap;">
            <th style="padding:10px 18px;">Empresa</th><th>Puesto</th><th>Entrevista</th><th>Próxima acción</th><th>Fecha acción</th><th>Postulada</th>
          </tr></thead>
          <tbody>
            {recs.map((a) => (
              <tr style="border-top:1px solid var(--color-border);">
                <td style="padding:9px 18px;"><a href={`/ofertas/${a.offer_id}`}>{a.company}</a></td>
                <td style="color:var(--color-text);">{a.title}</td>
                <td style={a.fecha_entrevista ? (a.venc_ent ? 'color:var(--color-danger); font-weight:600;' : 'color:var(--color-primary); font-weight:600;') : 'color:var(--color-muted);'}>{a.fecha_entrevista ? (a.fecha_entrevista + (a.venc_ent ? ' · pasó' : '')) : '—'}</td>
                <td style="color:var(--color-text);">{a.proxima_accion || '—'}</td>
                <td style={a.venc_prox ? 'color:var(--color-danger);' : 'color:var(--color-muted);'}>{a.fecha_proxima ? (a.fecha_proxima + (a.venc_prox ? ' · pasó' : '')) : '—'}</td>
                <td style="color:var(--color-muted);">{a.postulada ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {!err && <KanbanBoard client:load initial={initial} abiertasOcultas={abiertasOcultas} />}
</Base>
